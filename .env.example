# Copy to .env.local (never commit real values). All keys are read server-side only.

# Public site URL, used for metadata, sitemap and PayFast return URLs
SITE_URL=http://localhost:3000

# --- PayFast (https://developers.payfast.co.za) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# "true" uses sandbox.payfast.co.za, anything else uses the live gateway
PAYFAST_SANDBOX=true

# --- Newsletter (Mailchimp Marketing API) ---
MAILCHIMP_API_KEY=
# e.g. us21 — the suffix after the dash in your API key
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- Contact form email delivery (Resend, https://resend.com) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "MLAZA <hello@yourdomain>"
CONTACT_FROM_EMAIL=
